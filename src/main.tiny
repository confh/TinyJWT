import std "json";
import std "time";

native fn base64urlEncode(input: string): string {
    go {
        import "encoding/base64"
        return base64.RawURLEncoding.EncodeToString([]byte(input))
    }
}

native fn base64urlDecode(input: string): string {
    go {
        import "encoding/base64"
        data, err := base64.RawURLEncoding.DecodeString(input)
        if err != nil {
            return ""
        }
        return string(data)
    }
}

native fn hmacSha256(message: string, secret: string): string {
    go {
        import "crypto/hmac"
        import "crypto/sha256"
        import "encoding/base64"

        mac := hmac.New(sha256.New,[]byte(secret))
        mac.Write([]byte(message))
        sig := mac.Sum(nil)
        return base64.RawURLEncoding.EncodeToString(sig)
    }
}

native fn secureCompare(a: string, b: string): bool {
    go {
        import "crypto/subtle"
        return subtle.ConstantTimeCompare([]byte(a),[]byte(b)) == 1
    }
}

export class JWT {
    field secret = "";

    fn init(secret: string) {
        this.secret = secret;
    }

    fn sign(payload: object, expireSeconds: number): string {
        let iat = time.nowSec();
        payload["iat"] = iat;

        if expireSeconds > 0 {
            payload["exp"] = iat + expireSeconds;
        }

        let header = {
            "alg": "HS256",
            "typ": "JWT"
        };

        let headerStr = json.stringify(header);
        let payloadStr = json.stringify(payload);

        let encodedHeader = base64urlEncode(headerStr);
        let encodedPayload = base64urlEncode(payloadStr);

        let message = `${encodedHeader}.${encodedPayload}`;
        let signature = hmacSha256(message, this.secret);

        return `${message}.${signature}`;
    }

    fn verify(token: string) {
        let parts = token.split(".")
        if parts.length() != 3 {
            return {
                "valid": false,
                "error": "Invalid token structure (must contain header, payload, and signature)"
            };
        }

        let headerB64 = parts.get(0);
        let payloadB64 = parts.get(1);
        let signature = parts.get(2);

        let message = `${headerB64}.${payloadB64}`;
        let expectedSignature = hmacSha256(message, this.secret);

        if ! secureCompare(signature, expectedSignature) {
            return {
                "valid": false,
                "error": "Signature verification failed (tampered token)"
            };
        }

        let payloadStr = base64urlDecode(payloadB64);
        if payloadStr == "" {
            return {
                "valid": false,
                "error": "Failed to decode base64url payload"
            };
        }

        let payload = json.parse(payloadStr);
        if typeof payload == "null" {
            return {
                "valid": false,
                "error": "Failed to parse payload JSON"
            };
        }

        if typeof payload["exp"] != "null" {
            let now = time.nowSec();
            if now > payload["exp"] {
                return {
                    "valid": false,
                    "error": "Token has expired",
                    "payload": payload
                };
            }
        }

        return {
            "valid": true,
            "payload": payload
        };
    }

    fn decode(token: string) {
        let parts = token.split(".");
        if parts.length() != 3 {
            return {
                "success": false,
                "error": "Invalid token structure (must contain header, payload, and signature)",
                "header": null,
                "payload": null
            };
        }

        let headerB64 = parts.get(0);
        let payloadB64 = parts.get(1);

        let headerStr = base64urlDecode(headerB64);
        if headerStr == "" {
            return {
                "success": false,
                "error": "Failed to decode base64url header",
                "header": null,
                "payload": null
            };
        }

        let payloadStr = base64urlDecode(payloadB64);
        if payloadStr == "" {
            return {
                "success": false,
                "error": "Failed to decode base64url payload",
                "header": null,
                "payload": null
            };
        }

        let header = json.parse(headerStr);
        if typeof header == "null" {
            return {
                "success": false,
                "error": "Failed to parse header JSON",
                "header": null,
                "payload": null
            };
        }

        let payload = json.parse(payloadStr);
        if typeof payload == "null" {
            return {
                "success": false,
                "error": "Failed to parse payload JSON",
                "header": header,
                "payload": null
            };
        }

        return {
            "success": true,
            "header": header,
            "payload": payload
        };
    }
}